            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/pembayaran"
          }
        },
        {
          "name": "Catat Pembayaran",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/pembayaran/1",
            "body": { "mode": "raw", "raw": "{\n  \"nominal\": 150000,\n  \"metodePembayaran\": \"Tunai\"\n}" }
          }
        }
      ]
    },
